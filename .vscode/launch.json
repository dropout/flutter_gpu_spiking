    "version": "0.2.0",
    "configurations": [
        {
            "name": "Shader Lab",
            "request": "launch",
            "type": "dart",
            "program": "lib/lab.dart",
            "args": [
                "--enable-flutter-gpu"
            ]
        },
        {
            "name": "Ideas",
            "request": "launch",
            "type": "dart",
            "program": "lib/ideas.dart",
            "args": [
                "--enable-flutter-gpu"
            ]
        },
        {
            "name": "Ideas (profile mode)",
            "request": "launch",
            "type": "dart",
            "program": "lib/ideas.dart",
            "args": [
                "--enable-flutter-gpu"
            ],
            "flutterMode": "profile"
        },
        {
            "name": "Ideas (release mode)",
            "request": "launch",
            "type": "dart",
            "program": "lib/ideas.dart",
            "args": [
                "--enable-flutter-gpu"
            ],
            "flutterMode": "release"
        },
    ]
}